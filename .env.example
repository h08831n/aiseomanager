# ==============================================================================
# AUTONOMOUS AI SEO OPERATING SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# CRITICAL SECURITY POLICIES:
# 1. Never commit .env or raw credentials to git/source control.
# 2. Never use fake, dummy, or placeholder fallback values in production.
# 3. Autonomous mutation is disabled by default for safety (AUTONOMOUS_EXECUTION_ENABLED=false).
# ==============================================================================


# ==============================================================================
# 1. POSTGRESQL DATABASE REQUIREMENTS & CONFIGURATION
# ==============================================================================
# Requirements:
# - PostgreSQL 14, 15, or 16+ is required for production persistence.
# - The database must support connection pooling (e.g. PgBouncer, Supabase, Cloud SQL Proxy, AWS RDS).
# - Two distinct connection URLs are required:
#     1) DATABASE_URL: Pooled connection string for application runtime queries (port 6543/5432).
#     2) DIRECT_URL: Direct unpooled connection string used exclusively by Prisma migrations
#        and schema deployments (port 5432).
#
# Local Development:
#   DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/ai_seo_manager?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres_dev_password@localhost:5432/ai_seo_manager?schema=public"
#
# Production (e.g. Supabase / Cloud SQL / AWS RDS):
#   DATABASE_URL="postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"
#   DIRECT_URL="postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres"

DATABASE_URL=
DIRECT_URL=
PG_POOL_MAX=10


# ==============================================================================
# 2. ENCRYPTION AT REST (SECRET VAULT)
# ==============================================================================
# Requirements:
# - Required for encrypting sensitive third-party credentials (OAuth refresh tokens, CMS passwords, API keys) at rest.
# - Algorithm: AES-256-GCM with cryptographically random initialization vectors and HMAC auth tags.
# - Key specification: Must be a 32-byte key (either a 64-character hex string or 32-byte raw string).
#
# Key Generation (run in terminal):
#   openssl rand -hex 32
#
# Example (do NOT use this in production; generate your own):
#   ENCRYPTION_MASTER_KEY=4a8f9c2d1e0b5a7c3e9f1d2b4a6c8e0f1a3b5c7d9e1f3a5b7c9d1e3f5a7b9c1d

ENCRYPTION_MASTER_KEY=


# ==============================================================================
# 3. GOOGLE OAUTH 2.0 (SEARCH CONSOLE & ANALYTICS 4)
# ==============================================================================
# Requirements & Setup Steps:
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Create or select a Google Cloud Project.
# 3. Enable the required Google APIs in "APIs & Services" > "Library":
#      - Google Search Console API (webmasters.readonly)
#      - Google Analytics Data API (analytics.readonly)
#      - Google Analytics Admin API (analytics.readonly)
# 4. Configure "OAuth Consent Screen":
#      - User Type: External (or Internal if Google Workspace organization)
#      - Add Scopes:
#          * https://www.googleapis.com/auth/webmasters.readonly
#          * https://www.googleapis.com/auth/analytics.readonly
#          * openid
#          * email
#          * profile
# 5. Create Credentials:
#      - Go to "APIs & Services" > "Credentials" > "Create Credentials" > "OAuth client ID"
#      - Application type: "Web application"
#      - Name: "Autonomous SEO Manager"
#      - Authorized JavaScript origins:
#          * Local: http://localhost:3000
#          * Production: https://yourdomain.com (or your Cloud Run / App URL)
#      - Authorized redirect URIs:
#          * Local: http://localhost:3000/api/integrations/google/callback
#          * Production: https://yourdomain.com/api/integrations/google/callback
# 6. Copy Client ID, Client Secret, and set your Redirect URI below:

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=


# ==============================================================================
# 4. AUTONOMOUS EXECUTION SAFETY KILLSWITCH
# ==============================================================================
# Safety Policy:
# - Autonomous execution must remain DISABLED BY DEFAULT ('false').
# - When set to 'false' (or omitted), all proposed SEO actions remain in 'RECOMMENDED' or
#   'PENDING_APPROVAL' states and require explicit human operator confirmation.
# - Set to 'true' ONLY after thoroughly testing in sandbox and validating target website authorization.
#
# Allowed values: 'false' | 'true' (default: 'false')

AUTONOMOUS_EXECUTION_ENABLED=false


# ==============================================================================
# 5. ASYNCHRONOUS WORKER & QUEUE ENGINE (REDIS)
# ==============================================================================
# Requirements:
# - Redis 6+ or 7+ is required in production for BullMQ task coordination, crawler dispatch,
#   and attribution evaluation jobs.
# - In local development, an in-process database poller fallback is used if REDIS_URL is omitted.
# - In production (NODE_ENV=production), REDIS_URL is strictly required.
#
# Local Development:
#   REDIS_URL="redis://localhost:6379"
# Production (e.g. Upstash, Redis Cloud, AWS ElastiCache, GCP Memorystore):
#   REDIS_URL="rediss://default:token@host:6379"

REDIS_URL=


# ==============================================================================
# 6. AI STRATEGIST (GEMINI API)
# ==============================================================================
# Requirements:
# - Required for autonomous SERP intent extraction, content gap analysis, and schema generation.
# - Obtain key from Google AI Studio: https://aistudio.google.com/
#
# Note: In production, store this in server-side secret management.

GEMINI_API_KEY=


# ==============================================================================
# 7. NETWORKING & CORS CONFIGURATION
# ==============================================================================
# Allowed cross-origin domains (comma-separated).
# In production, restrict to your verified frontend domain:
#   CORS_ALLOWED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"
# Defaults to '*' if unset in development.

CORS_ALLOWED_ORIGINS=


# ==============================================================================
# 8. APPLICATION RUNTIME MODE
# ==============================================================================
# Options: 'DEVELOPMENT' | 'PRODUCTION' | 'TEST'
# Set to 'PRODUCTION' to enforce strict environment validation and disable fallbacks.

APP_MODE=DEVELOPMENT
NODE_ENV=development
